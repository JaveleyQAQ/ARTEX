# 独立 Phase 1 验收环境。复制为 .env.phase1 后修改密码。
ARTEX_IMAGE=ghcr.io/javeleyqaq/artex
ARTEX_TAG=phase1-latest
POSTGRES_USER=artex
# 建议使用仅含字母和数字的长随机密码，避免 DSN URL 转义问题。
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_ALPHANUMERIC_PASSWORD
POSTGRES_DB=artex_phase1

# 可先留空，首次登录后也可在 ARTEX UI 中配置 LLM。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
